ARG BASE_IMAGE_VERSION=v0.5.10
FROM micr.cloud.mioffice.cn/llm-infra/sglang:${BASE_IMAGE_VERSION}
ENV PIP_INDEX_URL "https://pkgs.d.xiaomi.net/artifactory/api/pypi/pypi-virtual/simple"
ENV PIP_TRUSTED_HOST "pkgs.d.xiaomi.net"
ENV UV_BREAK_SYSTEM_PACKAGES=1

# Set pip index url
RUN python3 -m pip config set global.index-url ${PIP_INDEX_URL}

# System deps: git (required by pre-commit), clang-format-20 (C++/CUDA lint)
RUN apt-get update \
    && apt-get install -y --no-install-recommends git wget vim \
    && apt-get install -y --no-install-recommends clang-format-20 \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

# Pre-commit
RUN pip install --no-cache-dir pre-commit && pre-commit install-hooks -c .pre-commit-config.yaml
RUN bash scripts/ci/cuda/ci_install_dependency.sh
RUN rm -fr /sgl-workspace/sglang

# Install GitLab Runner
RUN curl -L "https://packages.gitlab.com/install/repositories/runner/gitlab-runner/script.deb.sh" | bash \
    && apt-get install -y gitlab-runner vim \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install Claude Code (requires Node.js).
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y nodejs \
    && npm install -g @anthropic-ai/claude-code \
    && npm cache clean --force \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p ~/.claude/skills/ \
    && git clone git@git.n.xiaomi.com:ai-studio/cloudml-service-deploy-skill.git \
  ~/.claude/skills/cloudml-service-deploy

RUN python3 -m pip install https://cnbj1-fds.api.xiaomi.net/aie-shared-objects/20260514/transfer_kernel-0.4.1-cp310-abi3-linux_x86_64.whl \
    --no-cache-dir --no-deps --force-reinstall
RUN python3 -m pip install https://cnbj1-fds.api.xiaomi.net/aie-shared-objects/20260603/pos_enc_kernel-0.4.1-cp310-abi3-linux_x86_64.whl \
    --no-cache-dir --no-deps --force-reinstall

WORKDIR /
