# Reuse the official release's dependencies, kernels, and compiled Rust extensions.
# BASE_IMAGE can also point to an internal mirror of this same release.
ARG BASE_IMAGE=lmsysorg/sglang:v0.5.20
FROM ${BASE_IMAGE} AS runtime

WORKDIR /sgl-workspace/sglang

# The official image installs SGLang editable at this path. Check that contract
# before overlaying local source so an incompatible base cannot run stale code.
RUN python3 -c "from importlib import metadata, util; from pathlib import Path; \
    version = metadata.version('sglang'); \
    assert version.split('+', 1)[0] == '0.5.20', f'Expected SGLang 0.5.20, got {version}'; \
    spec = util.find_spec('sglang'); \
    expected = Path('/sgl-workspace/sglang/python/sglang/__init__.py'); \
    assert spec is not None and spec.origin and Path(spec.origin).resolve() == expected, \
        f'Expected an editable SGLang installation at {expected}, got {spec}'"

# Overlay the checkout while retaining the base image's generated _version.py
# and compiled .so files, which .dockerignore excludes from the build context.
# Dependency or Rust source changes require a matching rebuilt base image.
COPY . .

# Keep build provenance at the end so metadata changes do not invalidate build layers.
ARG SGLANG_BUILD_COMMIT=unknown
ARG SGLANG_BUILD_URL=
ARG SGLANG_IMAGE_TAG=local/sglang:dev
ENV SGLANG_BUILD_COMMIT=${SGLANG_BUILD_COMMIT:-unknown} \
    SGLANG_BUILD_URL=${SGLANG_BUILD_URL:-} \
    SGLANG_IMAGE_TAG=${SGLANG_IMAGE_TAG:-local/sglang:dev}
LABEL org.opencontainers.image.source="https://github.com/sgl-project/sglang" \
      org.opencontainers.image.revision="${SGLANG_BUILD_COMMIT}" \
      org.opencontainers.image.version="${SGLANG_IMAGE_TAG}" \
      org.opencontainers.image.url="${SGLANG_BUILD_URL}" \
      ai.sglang.build.commit="${SGLANG_BUILD_COMMIT}" \
      ai.sglang.build.url="${SGLANG_BUILD_URL}" \
      ai.sglang.image.tag="${SGLANG_IMAGE_TAG}"

CMD ["/bin/bash"]
