# Reuse the official release's dependencies, kernels, and compiled Rust extensions.
# BASE_IMAGE can also point to an internal mirror of this same release.
ARG BASE_IMAGE=lmsysorg/sglang:v0.5.20
FROM ${BASE_IMAGE} AS runtime

WORKDIR /sgl-workspace/sglang

# The official image installs SGLang editable at this path. Check that contract
# before overlaying local source so an incompatible base cannot run stale code.
RUN python3 -c "from importlib import metadata, util; from pathlib import Path; \
    version = metadata.version('sglang'); \
    assert version.split('+', 1)[0] == '0.5.20', f'Expected SGLang 0.5.20, got {version}'; \
    spec = util.find_spec('sglang'); \
    expected = Path('/sgl-workspace/sglang/python/sglang/__init__.py'); \
    assert spec is not None and spec.origin and Path(spec.origin).resolve() == expected, \
        f'Expected an editable SGLang installation at {expected}, got {spec}'"

# Enable CUDA 13.0 forward compatibility on H20 hosts with an R570 driver.
# The official CUDA base normally includes this package; install it if missing.
RUN if [ ! -r /usr/local/cuda-13.0/compat/libcuda.so.1 ]; then \
        apt-get update \
        && apt-get install -y --no-install-recommends cuda-compat-13-0 \
        && rm -rf /var/lib/apt/lists/*; \
    fi \
    && test -r /usr/local/cuda-13.0/compat/libcuda.so.1
ENV LD_LIBRARY_PATH="/usr/local/cuda-13.0/compat:${LD_LIBRARY_PATH}"

# GCache is optional for the Python package; the internal image includes the
# same Python 3.12 SDK wheel as the legacy deployment.
ARG GCACHE_SDK_WHEEL_URL=https://cnbj1-fds.api.xiaomi.net/juicefs/gcache/release/2.1/20260917-5978d0b2/gcache_sdk-2.1.0+g5978d0b2.py312.release.2.1-py3-none-any.whl
ARG GCACHE_SDK_WHEEL_SHA256=33df5f536cf06b16fce597b1461e9a52755c0d29ef584850f68dc1e94a6daf8b
# Despite its py3-none-any filename, this wheel contains a CPython 3.12
# x86_64 native extension. Fail clearly before installing on a different ABI.
RUN python3 -c "import platform, sys; \
    assert sys.implementation.name == 'cpython' and sys.version_info[:2] == (3, 12) \
        and platform.system() == 'Linux' and platform.machine() == 'x86_64', \
        'The pinned GCache SDK requires CPython 3.12 on Linux x86_64'" \
    && python3 -m pip install --no-cache-dir --no-deps "${GCACHE_SDK_WHEEL_URL}#sha256=${GCACHE_SDK_WHEEL_SHA256}" \
    && python3 -c "from importlib.metadata import version; from gcache_sdk import GCacheClient; \
        assert version('gcache-sdk') == '2.1.0+g5978d0b2.py312.release.2.1'"
COPY docker/gcache.flags /sgl-workspace/gcache.flags
COPY --chmod=755 docker/wait-gcache-server.sh /home/work/gcache/wait-gcache-server.sh

# DeepGEMM with W4A8 + sm90 megamoe kernels (branch combine_earlier_w4a8_mega_moe_sm90 @de9009a)
RUN cd /tmp && \
    wget -q -O deep_gemm-2.5.0+de9009a-cp312-cp312-linux_x86_64.whl 'https://cnbj1-fds.api.xiaomi.net/deepgemm/deep_gemm-2.5.0+de9009a-cp312-cp312-linux_x86_64.whl?GalaxyAccessKeyId=5151729087601&Expires=9223372036854775807&Signature=2g79y9cot4XI3Kql%2BfbQwQAfqYU%3D' && \
    python3 -m pip install /tmp/deep_gemm-2.5.0+de9009a-cp312-cp312-linux_x86_64.whl --no-cache-dir --no-dependencies --force-reinstall && \
    rm -f /tmp/deep_gemm-2.5.0+de9009a-cp312-cp312-linux_x86_64.whl

# Overlay the checkout while retaining the base image's generated _version.py
# and compiled .so files, which .dockerignore excludes from the build context.
# Dependency or Rust source changes require a matching rebuilt base image.
COPY . .

# Keep build provenance at the end so metadata changes do not invalidate build layers.
ARG SGLANG_BUILD_COMMIT=unknown
ARG SGLANG_BUILD_URL=
ARG SGLANG_IMAGE_TAG=local/sglang:dev
ENV SGLANG_BUILD_COMMIT=${SGLANG_BUILD_COMMIT:-unknown} \
    SGLANG_BUILD_URL=${SGLANG_BUILD_URL:-} \
    SGLANG_IMAGE_TAG=${SGLANG_IMAGE_TAG:-local/sglang:dev}
LABEL org.opencontainers.image.source="https://github.com/sgl-project/sglang" \
      org.opencontainers.image.revision="${SGLANG_BUILD_COMMIT}" \
      org.opencontainers.image.version="${SGLANG_IMAGE_TAG}" \
      org.opencontainers.image.url="${SGLANG_BUILD_URL}" \
      ai.sglang.build.commit="${SGLANG_BUILD_COMMIT}" \
      ai.sglang.build.url="${SGLANG_BUILD_URL}" \
      ai.sglang.image.tag="${SGLANG_IMAGE_TAG}"

CMD ["/bin/bash"]
