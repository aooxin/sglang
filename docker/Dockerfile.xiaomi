ARG BASE_IMAGE_VERSION=v0.5.10
FROM micr.cloud.mioffice.cn/llm-infra/sglang:${BASE_IMAGE_VERSION}

ARG UBUNTU_MIRROR=https://pkgs.d.xiaomi.net/artifactory/deb-remote/ubuntu/
ARG PIP_DEFAULT_INDEX=https://pkgs.d.xiaomi.net/artifactory/api/pypi/pypi-virtual/simple
ARG BUILD_MAX_JOBS=128
ARG DEBIAN_FRONTEND=noninteractive
# Set to 1 to bake FlashAttention-4 (CUTE) + sm120 patch for RTX 5090 / Blackwell.
ARG ENABLE_FA4_SM120=0

RUN if [ -n "${PIP_DEFAULT_INDEX}" ]; then \
    python3 -m pip config set global.index-url ${PIP_DEFAULT_INDEX}; \
fi

RUN if [ -n "$UBUNTU_MIRROR" ]; then \
      sed -i "s|http://.*archive.ubuntu.com|$UBUNTU_MIRROR|g" /etc/apt/sources.list && \
      sed -i "s|http://.*security.ubuntu.com|$UBUNTU_MIRROR|g" /etc/apt/sources.list; \
    fi && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
      dnsutils \
      librados-dev \
      jq \
      ffmpeg \
      ca-certificates && \
    apt-get install --only-upgrade -y sudo && \
    rm -rf /var/lib/apt/lists/*

# for tokenizer: fastokens
# for debugging: py-spy, nvtx
# for omni: torchcodec, joblib, accelerate, decord, apache-tvm-ffi
RUN python3 -m pip install --no-cache-dir --break-system-packages --no-build-isolation --no-deps \
    py-spy==0.4.1 \
    nvtx==0.2.13 \
    torchcodec==0.9.1 \
    joblib==1.5.3 \
    accelerate==1.12.0 \
    decord==0.6.0 \
    "apache-tvm-ffi>=0.1.5,<0.2" \
    'fastokens==0.2.0'

# for encoder endpoint discovery (--enable-encoder-endpoint-discovery):
# K8s Endpoints watch. Install with deps (pyyaml/urllib3/python-dateutil/...).
RUN python3 -m pip install --no-cache-dir --break-system-packages \
    "kubernetes_asyncio>=29,<30"

# FlashAttention-4 (CUTE) for the MiMo ViT/audio "fa4" backend on Blackwell
# (sm120/RTX 5090). cute is overwritten with sunjiale's sm120-fix fork (PyPI is broken).
# Gated by ENABLE_FA4_SM120 — off by default for non-Blackwell builds.
RUN if [ "$ENABLE_FA4_SM120" = "1" ]; then \
    SP=$(python3 -c "import sysconfig; print(sysconfig.get_paths()['purelib'])") && \
    (python3 -m pip uninstall -y nvidia-cutlass-dsl nvidia-cutlass-dsl-libs-base || true) && \
    rm -rf "$SP/cutlass" "$SP/nvidia_cutlass_dsl" "$SP"/nvidia_cutlass_dsl*.pth && \
    python3 -m pip install --no-cache-dir --break-system-packages --no-build-isolation --no-deps \
    "nvidia-cutlass-dsl==4.4.2" \
    "nvidia-cutlass-dsl-libs-base==4.4.2" && \
    echo "nvidia_cutlass_dsl/python_packages" > "$SP/nvidia_cutlass_dsl.pth" && \
    python3 -m pip install --no-cache-dir --break-system-packages --no-build-isolation --no-deps \
    "flash-attn-4==4.0.0b7" \
    "quack-kernels==0.3.9" \
    "apache-tvm-ffi==0.1.9" && \
    wget -q https://wlcb-cloudml-starfs.api.xiaomi.net/aie-shared-models-n-datasets-wlcb/git/flash_attn_cute_sm120_7b18858.tar.gz -O /tmp/fa4cute.tar.gz && \
    tar -xzf /tmp/fa4cute.tar.gz -C /tmp && \
    cp -rf /tmp/flash_attn/cute/. "$SP/flash_attn/cute/" && \
    rm -rf /tmp/fa4cute.tar.gz /tmp/flash_attn && \
    grep -q "is_split_kv = False" "$SP/flash_attn/cute/flash_fwd_sm120.py" || (echo "ERROR: sm120 patch not applied" && exit 1) && \
    python3 -c "import cutlass; print('cutlass ->', getattr(cutlass, '__file__', None) or list(cutlass.__path__))" && \
    python3 -c "from cutlass import Int32, Float32; from flash_attn.cute import flash_attn_varlen_func; print('fa4 deps baked OK (sm120 patched)')"; \
fi

# cleanup sglang workspace
RUN rm -fr /sgl-workspace/sglang

RUN python3 -m pip install https://cnbj1-fds.api.xiaomi.net/git-assert/workspace/pro_test_whl/deepep/deep_ep-1.2.1+e16913a-cp312-cp312-linux_x86_64.whl \
    --no-cache-dir --no-deps --force-reinstall && \
    python3 -m pip install https://cnbj1-fds.api.xiaomi.net/aie-shared-objects/20260901/transfer_kernel-0.4.1-cp310-abi3-linux_x86_64.whl \
    --no-cache-dir --no-deps --force-reinstall

# DeepGEMM with sm90 megamoe kernel (cloudml-aie/DeepGEMM branch sm90-megamoe-coop-nsplit-per128 @b23a8a0).
RUN python3 -m pip install "https://cnbj1-fds.api.xiaomi.net/git-assets/test/0510/deep_gemm-2.5.0+local-cp312-cp312-linux_x86_64.whl" \
    --no-cache-dir --no-dependencies --force-reinstall

# gcache
COPY docker/gcache.flags /sgl-workspace/
RUN mkdir -p /home/work/gcache && \
    cd /home/work/gcache && \
    mkdir -p /home/work/log && \
    ln -s /home/work/log log && \
    python3 -m pip install --no-cache-dir https://cnbj1-fds.api.xiaomi.net/juicefs/gcache/release/2.1/20260811-a055ac5d/gcache_sdk-2.1.0+ga055ac5d.py312.release.2.1-py3-none-any.whl
COPY docker/wait-gcache-server.sh /home/work/gcache/

RUN python3 -m pip install https://git-assert.cnbj1.mi-fds.com/git-assert/mimo/moe_fused_gate-1.0.0-cp312-cp312-linux_x86_64.whl \
    --no-cache-dir --no-dependencies --force-reinstall
RUN python3 -m pip install https://git-assert.cnbj1.mi-fds.com/git-assert/pro/mimo_pro_moe_fused_gate-1.0.0-cp312-cp312-linux_x86_64.whl\
    --no-cache-dir --no-dependencies --force-reinstall

# ez_kernel_kit: CUDA decode kernel for MiMo FP8 KV cache
RUN python3 -m pip install https://artifactory.d.xiaomi.net/artifactory/mimo-core-pypi-local/ez-kernel-kit/0.3.0.dev89+fp8kv.g57e0e0e/ez_kernel_kit-0.3.0.dev89+fp8kv.g57e0e0e-cp312-cp312-linux_x86_64.whl \
    --no-cache-dir --no-dependencies --force-reinstall

# --- Node.js (LTS) + latest Claude Code ------------------------------------
# Claude Code is distributed as an npm package; install Node LTS from
# NodeSource, then the latest Claude Code globally.
RUN curl -fsSL https://deb.nodesource.com/setup_lts.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g @anthropic-ai/claude-code \
    && echo '{"hasCompletedOnboarding": true}' > /root/.claude.json \
    && claude --version

# --- Pre-install CloudML skill dependency (cloudml-mimo-analyze) ------------
ARG GITLAB_API_TOKEN
RUN if [ -n "${GITLAB_API_TOKEN}" ]; then \
        AUTH="$(printf '%s:%s' oauth2 "${GITLAB_API_TOKEN}" | base64 -w0)"; \
        git -c "http.https://git.n.xiaomi.com/.extraheader=Authorization: Basic ${AUTH}" \
            clone --depth 1 https://git.n.xiaomi.com/ai-studio/cloudml-claude-plugins.git /opt/cloudml-claude-plugins; \
    else \
        GIT_SSH_COMMAND="ssh -o StrictHostKeyChecking=accept-new" \
            git clone --depth 1 git@git.n.xiaomi.com:ai-studio/cloudml-claude-plugins.git /opt/cloudml-claude-plugins; \
    fi \
    && rm -rf /opt/cloudml-claude-plugins/.git \
    && claude plugin marketplace add /opt/cloudml-claude-plugins \
    && claude plugin install cloudml-mimo-analyze@cloudml-claude-plugins --yes \
    && grep -q 'cloudml-mimo-analyze@cloudml-claude-plugins' /root/.claude/plugins/installed_plugins.json

COPY . .

# Set workspace directory
WORKDIR /sgl-workspace/sglang
