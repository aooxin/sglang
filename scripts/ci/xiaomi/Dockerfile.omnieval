FROM micr.cloud.mioffice.cn/base_model/lmms-eval:v0.10.1-0223-sglang0.5.7

RUN --mount=type=ssh \
      mkdir -p ~/.claude/skills/ && \
      GIT_SSH_COMMAND="ssh -o StrictHostKeyChecking=no" \
      git clone --branch dev/shaohui/cloudml-api git@git.n.xiaomi.com:sunzongyu/cloudml-service-deploy.git \
        ~/.claude/skills/cloudml-service-deploy

RUN pip install zhon==2.1.1 jiwer==3.1.0 zhconv==1.4.3 funasr==1.2.7 stopes==2.2.1  s3prl==0.4.18 torchaudio==2.8.0 torchvision==0.23.0 setuptools==79.0.1 sacrebleu==1.5.1 aiofiles==25.1.0 whisper -i https://pkgs.d.xiaomi.net/artifactory/api/pypi/pypi-virtual/simple --break-system-packages

WORKDIR /app/lmms-eval
RUN --mount=type=ssh GIT_SSH_COMMAND="ssh -o StrictHostKeyChecking=no" git clone --branch dev/sunjiale/ci --depth 1 git@git.n.xiaomi.com:bigmodelcore/lmms-eval.git .
WORKDIR /app/mimo-video-eval
RUN --mount=type=ssh GIT_SSH_COMMAND="ssh -o StrictHostKeyChecking=no" git clone --branch dev/sunjiale/ci --depth 1 git@git.n.xiaomi.com:yuezihao/mimo-video-eval.git .
WORKDIR /app/mimo-audio-eval
RUN --mount=type=ssh GIT_SSH_COMMAND="ssh -o StrictHostKeyChecking=no" git clone --branch dev/sunjiale/mimo_audio_eval --depth 1 git@git.n.xiaomi.com:mimo-audio/mimo-audio-eval.git .
RUN ln -s /root/.cache/huggingface/omni_dataset/audio /app/mimo-audio-eval/data
